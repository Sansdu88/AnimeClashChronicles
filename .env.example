# Copy this file to .env and fill in your Supabase project
# (Supabase dashboard → Project Settings → API Keys), then apply the SQL files of supabase/migrations/ (in order).
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key: server only, never share it or put it in the website.
SUPABASE_SECRET_KEY=sb_secret_...
