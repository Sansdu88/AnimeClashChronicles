# Copy this file to .env and fill in your Supabase project keys
# (Supabase dashboard → Project Settings → API Keys), then run supabase/schema.sql once.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only, never share it or put it in the website.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
